{
    "name": "vinceamstoutz/symfony-security-auditor-example-vulnerable-app",
    "description": "Intentionally vulnerable Symfony skeleton for demonstrating symfony-security-auditor. DO NOT DEPLOY.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "symfony/ai-anthropic-platform": "^0.14",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "vinceamstoutz/symfony-security-auditor": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
